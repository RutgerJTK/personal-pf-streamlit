{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::personal-pf-streamlit-s3-bucket/cleaned/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::personal-pf-streamlit-s3-bucket",
      "Condition": { "StringLike": { "s3:prefix": "cleaned/*" } }
    }
  ]
}
